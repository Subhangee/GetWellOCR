# Copy this file to ".env" and fill in your own values.
# ".env" is in .gitignore, so your keys never reach GitHub.

# Azure Document Intelligence (create the resource in an EU region,
# e.g. Germany West Central or West Europe)
AZURE_DI_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DI_KEY=<paste-key-1-here>

# Which OCR engine the app uses by default: tesseract | azure | paddle
OCR_ENGINE=tesseract

# Best-of OCR: read each page in 3 cleanup variants, keep the best reading (about 3x slower): 0 | 1
OCR_BEST_OF=0

# Only needed if Python cannot find Tesseract on its own
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
